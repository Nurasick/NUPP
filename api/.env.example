# Copy to api/.env for `go run`. Real environment variables take precedence.
DATABASE_URL=postgres://nupp:change-me@localhost:5433/nupp?sslmode=disable
HTTP_ADDR=:8080
STORAGE_DIR=./data/files
APP_ENV=development
